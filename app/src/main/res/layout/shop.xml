<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/data_linear"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:background="#FFECB3"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/textmoney"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Деньги:"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/money"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="0"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/textfood"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Голод:"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/food"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="0"
			android:textSize="12sp"
			android:textColor="#000000" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/shop_scroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#FFF9C4">
		<LinearLayout
			android:id="@+id/shopOrganism"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:orientation="vertical">
			<Button
				android:id="@+id/buytwixbutton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Очень маленький твикс - 19 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
			<Button
				android:id="@+id/buttonbuynormaltwix"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Твикс - 53 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
			<Button
				android:id="@+id/buttonbuylargetwix"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Огромный твикс - 105 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
			<Button
				android:id="@+id/buttonbuycoffee"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Кофе - 240 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
			<Button
				android:id="@+id/buttonenergydrink"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Энергетик - 480 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
			<Button
				android:id="@+id/button_tigerpizza"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				android:padding="8dp"
				android:background="#FFD740"
				android:text="Пицца - 999 денег"
				android:textSize="12sp"
				android:textColor="#000000" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
