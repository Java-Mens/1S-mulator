<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/infoOrganism"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#FFF9C4"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_gravity="center_horizontal|center_vertical">
		<LinearLayout
			android:id="@+id/playerinfo"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="center_horizontal">
			<ImageView
				android:id="@+id/oneassicon"
				android:layout_width="150dp"
				android:layout_height="150dp"
				android:src="@drawable/oneassmulator"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/appnametext"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Симулятор программиста 1С"
				android:textSize="25sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="center_horizontal|center_vertical" />
		</LinearLayout>
		<TextView
			android:id="@+id/pushkintext"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Тяжела и не казиста,\nЖизнь простого программиста!\nБосс кричит, земля трясётся.\nВот как прогеру живётся!\n\nНадо жрать и отдыхать,\nГде бы только денег взять\?\nЩас закончу я отчёт.\nУх, как у меня печёт!"
			android:textSize="16sp"
			android:textColor="#000000" />
		<ImageView
			android:id="@+id/ad"
			android:layout_width="200dp"
			android:layout_height="100dp"
			android:src="@drawable/sample"
			android:scaleType="centerCrop" />
		<TextView
			android:id="@+id/infotext"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="В данном симуляторе игроку предстоит заботится об 1С-нике как о самом себе и пережить (а может быть и нет) незабываемый опыт работы программистом 1С. Вас ждут удивительные кейсы и аватарки."
			android:textSize="12sp"
			android:textColor="#000000"
			android:layout_gravity="center_horizontal|center_vertical" />
		<TextView
			android:id="@+id/goodlucktext"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="ЖЕЛАЕМ УСПЕХОВ!"
			android:textSize="30sp"
			android:textColor="#000000"
			android:layout_gravity="center_horizontal|bottom" />
	</LinearLayout>
</LinearLayout>
