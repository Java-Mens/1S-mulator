<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear5"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:background="#FFECB3"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/textview6"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Деньги:"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/money"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="0"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/textview8"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Настроение:"
			android:textSize="12sp"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/enjoy"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="0"
			android:textSize="12sp"
			android:textColor="#000000" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/enjoy_vscroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#FFF9C4">
		<LinearLayout
			android:id="@+id/enjoyOrganism"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/fun_things"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<TextView
					android:id="@+id/fun_textview"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Развлечения"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/funbutton1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Прогулка самым оптимальным маршрутом - 111 денег"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/funbutton2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Кино - 200 денег"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/funbutton3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Порезвиться и покувыркаться - 400 денег"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/funbutton4"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Не заниматься 1С - 1000 денег"
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/anecdots"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<TextView
					android:id="@+id/anecdot_textview"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Анекдоты"
					android:textSize="12sp"
					android:textColor="#000000" />
				<TextView
					android:id="@+id/funny_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Привет, я смешной! Чем анекдот смешнее, тем больше настроения!"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/buyanecdotbutton"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Купить случайный анекдот - 100 денег"
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
