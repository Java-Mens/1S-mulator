<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/bossOrganism"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:background="#FFE082"
		android:gravity="left|center_vertical"
		android:orientation="horizontal">
		<de.hdodenhof.circleimageview.CircleImageView
			android:id="@+id/boss_chatavatar"
			android:layout_width="75dp"
			android:layout_height="75dp"
			android:src="@drawable/boss_cocks"
			app:civ_border_width="3dp"
			app:civ_border_color="#008DCD"
			app:civ_circle_background_color="#FFFFFF"
			app:civ_border_overlay="true" />
		<TextView
			android:id="@+id/boss_textview"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="БОСС"
			android:textSize="25sp"
			android:textColor="#000000" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/evilOrganism"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:background="#FFF9C4"
		android:orientation="vertical">
		<TextView
			android:id="@+id/evilboss_textview"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Уровень злости босса:"
			android:textSize="12sp"
			android:textColor="#000000" />
		<ProgressBar
			android:id="@+id/boss_progressbar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#FFFDE7"
			android:indeterminate="false"
			style="?android:progressBarStyleHorizontal" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/chat_vscroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#FFF9C4">
		<LinearLayout
			android:id="@+id/chat_linear"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/player_linear1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/player_textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:gravity="right"
					android:text="Здравствуйте!"
					android:textSize="12sp"
					android:textColor="#000000"
					android:layout_gravity="right" />
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/playeravatar1"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/cock1"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/boss_linear1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal">
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/circleimageview3"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/boss_cocks"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
				<TextView
					android:id="@+id/boss_textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Мм, ну привет, работничек) Ну-ка бегом заполнять конфигурацию! Я тебе за что деньги плачу\?!"
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/money_linear"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textplus"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="+"
					android:textSize="12sp"
					android:textColor="#000000" />
				<TextView
					android:id="@+id/money"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="0"
					android:textSize="12sp"
					android:textColor="#000000" />
				<TextView
					android:id="@+id/textmoney"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="денег"
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/player_linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/player_textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:gravity="right"
					android:text="Здравствуйте!"
					android:textSize="12sp"
					android:textColor="#000000"
					android:layout_gravity="right" />
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/playeravatar2"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/cock1"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/boss_linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal">
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/circleimageview6"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/boss_cocks"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
				<TextView
					android:id="@+id/boss_textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Ты что, совсем дурак\?!\?! Всё испортил, как всегда! Худший работник нашей компании! "
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/boss_linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal">
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/circleimageview9"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/boss_cocks"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
				<TextView
					android:id="@+id/boss_textview3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Так уж и быть, дам тебе ещё один шанс. Ещё раз не справишься с работой – сразу уволю."
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/player_linearprint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/player_printing"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="right"
					android:text="Печатает..."
					android:textSize="12sp"
					android:textColor="#000000"
					android:layout_gravity="right" />
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/playeravatar3"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/cock1"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/answer_linear"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="8dp"
				android:gravity="center_horizontal|bottom"
				android:orientation="vertical">
				<Button
					android:id="@+id/button_yes"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Готов приступить к работе!"
					android:textSize="12sp"
					android:textColor="#000000" />
				<Button
					android:id="@+id/button_no"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:background="#FFD740"
					android:text="Не сегодня."
					android:textSize="12sp"
					android:textColor="#000000" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
